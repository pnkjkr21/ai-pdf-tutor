# Copy to .env (Next.js and Prisma both read it). Do not commit .env.
# Postgres must be running before migrate / DB-backed routes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_pdf_tutor?schema=public"

# DeepSeek (server-side only — never NEXT_PUBLIC_*)
DEEPSEEK_API_KEY="sk-your-deepseek-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Local PDF storage root (relative to project root or absolute)
PDF_STORAGE_PATH="./storage/pdfs"

# Upload limits (Step 2+)
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=50

# Max PDF characters sent to DeepSeek for plan generation (Step 3)
MAX_PLAN_SOURCE_CHARS=60000

# Max PDF characters sent to DeepSeek for MCQ generation (Step 4; falls back to MAX_PLAN_SOURCE_CHARS)
MAX_QUIZ_SOURCE_CHARS=60000
